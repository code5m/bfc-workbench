<view class="page"><view class="brand">自选<text>按自己的顺序观看</text></view><view wx:if="{{loading}}">正在读取专题…</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{topics}}" wx:key="id" class="topic" data-id="{{item.id}}" bindtap="openTopic"><text class="title">{{item.name}}</text><text class="meta">{{item.items.length}} 个视频 · {{item.chapters.length}} 个章节</text><text class="description">{{item.description}}</text></view></view>
